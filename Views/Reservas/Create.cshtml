@model Hotel.Web.Models.Reserva
@{ ViewData["Title"] = "Nueva reserva"; }
<h1>Nueva reserva</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Huésped</label>
        <select asp-for="IdHuesped" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Huespedes"></select>
        <span asp-validation-for="IdHuesped" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Habitación</label>
        <select asp-for="IdHabitacion" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Habitaciones"></select>
        <span asp-validation-for="IdHabitacion" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="FechaIngreso" class="form-label"></label>
        <input asp-for="FechaIngreso" type="date" class="form-control" />
        <span asp-validation-for="FechaIngreso" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="FechaSalida" class="form-label"></label>
        <input asp-for="FechaSalida" type="date" class="form-control" />
        <span asp-validation-for="FechaSalida" class="text-danger"></span></div>

    <!-- Campo agregado para Observaciones -->
    <div class="mb-3">
        <label asp-for="Observaciones" class="form-label"></label>
        <input asp-for="Observaciones" class="form-control" maxlength="200" />
        <span asp-validation-for="Observaciones" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Reservar</button>
    <a asp-action="Index" class="btn btn-link">Volver</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }