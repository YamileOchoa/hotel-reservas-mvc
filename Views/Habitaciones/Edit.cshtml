@model Hotel.Web.Models.Habitacion
@{ ViewData["Title"] = "Editar habitación"; }
<h1>Editar habitación</h1>
<form asp-action="Edit" method="post" class="panel">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-link">Volver</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }